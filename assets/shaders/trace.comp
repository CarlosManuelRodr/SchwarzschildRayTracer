/**
 * @file
 * @brief OpenGL 4.3 compute entry point for resumable progressive ray tracing.
 * One invocation owns one pixel (8x8 workgroups), including its random state.
 * Each batch advances at most 64 trace actions and yields after one finished sample.
 * The host clears batch counters and inserts barriers/fences between dispatch and readback.
 * The TRACE_CORE marker is replaced by the shared source when loading the shader.
 */
#version 430 core
#define real float
#define INOUT(T) inout T
#define OUT(T) out T
layout(local_size_x = 8, local_size_y = 8) in;

/**
 * @brief std430 mirror of rt::SphereData; keep host/shader lane layouts identical.
 */
struct SphereData
{
    vec4 centerRadius;
    ivec4 material;
};

/**
 * @brief std430 material kind, base texture, physical parameters, and optional Earth layers.
 */
struct MaterialData
{
    ivec4 kindTexture;
    vec4 parameters;
    ivec4 layers;
};

/**
 * @brief std430 texture graph record; image.w selects float, packed sRGB, or packed linear data.
 */
struct TextureData
{
    ivec4 kindChildren;
    vec4 color;
    ivec4 image;
};

/**
 * @brief Seven 16-byte lanes (112 bytes) preserving one unfinished sample.
 * p/v/throughput/radiance use xyz. integration stores h2, step, observerLapse, energy.
 * meta stores field, attempts, depth, status. random stores RNG, observer mode, body+1,
 * and a reserved zero lane. Keep loadState/storeState and host StoredState synchronized.
 */
struct StoredState
{
    vec4 p;
    vec4 v;
    vec4 throughput;
    vec4 radiance;
    vec4 integration;
    ivec4 meta;
    uvec4 random;
};

/**
 * @brief Diagnostic world origin and initial look direction; w lanes are unused.
 */
struct TestRay
{
    vec4 origin;
    vec4 direction;
};

/**
 * @brief Read-only scene arrays use bindings 0..3; their indices are validated on the CPU.
 * Bindings 4 and 5 store resumable pixel states and per-batch counters. Binding 6 holds
 * diagnostic rays and binding 7 holds packed image data. The floating texel array also
 * contains the blackbody table at thermalOffset.
 */
layout(std430, binding = 0) readonly buffer Spheres
{
    SphereData spheres[];
};

layout(std430, binding = 1) readonly buffer Materials
{
    MaterialData materials[];
};

layout(std430, binding = 2) readonly buffer Textures
{
    TextureData textures[];
};

layout(std430, binding = 3) readonly buffer Texels
{
    vec4 texels[];
};

layout(std430, binding = 4) buffer States
{
    StoredState states[];
};

layout(std430, binding = 5) buffer Counters
{
    uint activePixels;
    uint failed;
    uint completed;
    uint missingFirstSample;
};

layout(std430, binding = 6) readonly buffer TestRays
{
    TestRay testRays[];
};

layout(std430, binding = 7) readonly buffer ImageTexels
{
    uint imageTexels[];
};

/**
 * @brief Per-pixel linear radiance sum in RGB and completed sample count in alpha.
 * bodyIds stores the first-sample sphere ID, with -1 for background. Image y=0 is the bottom.
 */
layout(rgba32f, binding = 0) uniform image2D accumulation;
layout(r32i, binding = 1) uniform iimage2D bodyIds;
uniform ivec2 dimensions;
uniform int targetSamples, resetState, testMode;
uniform int firstPassOnly;
uniform int gravityMode;
uniform vec3 observerBeta;
uniform int useObserverFrame;
uniform int observerType;

/**
 * @brief Host uniform adapters consumed by the shared CPU/GLSL core.
 * observerBeta is already converted from view-local to world-aligned local-frame axes;
 * observerType selects Hovering (0) or FreelyFalling (1), independently of gravityMode.
 */
bool hoveringObserver()
{
    return observerType == 0;
}

vec3 observerVelocity()
{
    return observerBeta;
}

bool observerFrameEnabled()
{
    return useObserverFrame != 0;
}

int integrationMode()
{
    return gravityMode;
}

uniform uint seed;
uniform vec3 cameraOrigin, cameraCorner, cameraHorizontal, cameraVertical;
uniform float relTolerance, absTolerance, maxStep;
uniform int maxAttempts;
uniform int holeIndex, planetIndex, thermalOffset, diskOn, useRedshift;
uniform vec4 diskConfig;
uniform vec3 diskAxis;
uniform float airHeight;

/**
 * @brief Scene/material/disk accessors isolate std430 packing from the physics core.
 * Missing hole/planet indices are -1; optional material texture layers are also -1.
 */
int sphereCount()
{
    return spheres.length();
}

vec3 sphereCenter(int i)
{
    return spheres[i].centerRadius.xyz;
}

real sphereRadius(int i)
{
    return spheres[i].centerRadius.w;
}

int sphereMaterial(int i)
{
    return spheres[i].material.x;
}

int materialKind(int i)
{
    return materials[i].kindTexture.x;
}

int materialTexture(int i)
{
    return materials[i].kindTexture.y;
}

int materialLayer(int i, int layer)
{
    return materials[i].layers[layer];
}

real materialParameter(int i)
{
    return materials[i].parameters.x;
}

vec3 materialEmission(int i)
{
    return materials[i].parameters.yzw;
}

int blackHole()
{
    return holeIndex;
}

int planet()
{
    return planetIndex;
}

bool diskEnabled()
{
    return diskOn != 0;
}

vec3 diskNormal()
{
    return diskAxis;
}

real diskInner()
{
    return diskConfig.x;
}

real diskOuter()
{
    return diskConfig.y;
}

real diskPeakTemperature()
{
    return diskConfig.z;
}

real diskScale()
{
    return diskConfig.w;
}

real atmosphereHeight()
{
    return airHeight;
}

bool redshiftEnabled()
{
    return useRedshift != 0;
}

vec3 thermalTexel(int i)
{
    return texels[thermalOffset + i].xyz;
}

int textureKind(int i)
{
    return textures[i].kindChildren.x;
}

int textureChild(int i, bool odd)
{
    return odd ? textures[i].kindChildren.y : textures[i].kindChildren.z;
}

vec3 textureColor(int i)
{
    return textures[i].color.xyz;
}

/**
 * @brief Fetch one texel, wrapping longitude and clamping latitude.
 * Decode sRGB before filtering; normal maps/masks use linear data and skip decoding.
 */
vec3 imageTexel(int i, int x, int y)
{
    ivec4 t = textures[i].image;
    x = (x % t.y + t.y) % t.y;
    y = clamp(y, 0, t.z - 1);

    if (t.w == 0)
        return texels[t.x + x + y * t.y].xyz;

    uint texelBits = imageTexels[t.x + x + y * t.y];
    vec3 c = vec3(texelBits & 255u, (texelBits >> 8) & 255u, (texelBits >> 16) & 255u) / 255.0;

    if (t.w == 1)
        c = mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
    return c;
}

/**
 * @brief Sample an equirectangular image with bottom-up UVs and top-down stored rows.
 * Packed textures use bilinear filtering; float reference fixtures retain nearest lookup.
 */
vec3 imageValue(int i, real u, real v)
{
    ivec4 t = textures[i].image;

    if (t.w == 0)
        return imageTexel(i, clamp(int(u * t.y), 0, t.y - 1),
                          clamp(int((1.0 - v) * t.z - 0.001), 0, t.z - 1));
    vec2 p = vec2(u * t.y, (1.0 - v) * t.z) - 0.5;
    ivec2 base = ivec2(floor(p));
    vec2 f = fract(p);

    return mix(mix(imageTexel(i, base.x, base.y), imageTexel(i, base.x + 1, base.y), f.x),
               mix(imageTexel(i, base.x, base.y + 1), imageTexel(i, base.x + 1, base.y + 1), f.x), f.y);
}

real maximumStep()
{
    return maxStep;
}

real relativeTolerance()
{
    return relTolerance;
}

real absoluteTolerance()
{
    return absTolerance;
}

int maximumAttempts()
{
    return maxAttempts;
}

bool finiteScalar(real v)
{
    return !isnan(v) && !isinf(v);
}

// TRACE_CORE
/**
 * @brief Restore a resumable trace from the explicit GPU storage lanes.
 */
TraceState loadState(int i)
{
    StoredState a = states[i];
    TraceState s;
    s.p = a.p.xyz;
    s.v = a.v.xyz;
    s.throughput = a.throughput.xyz;
    s.radiance = a.radiance.xyz;
    s.h2 = a.integration.x;
    s.step = a.integration.y;
    s.observerLapse = a.integration.z;
    s.energy = a.integration.w;
    s.observerMode = int(a.random.y);
    s.body = int(a.random.z) - 1;
    s.field = a.meta.x;
    s.attempts = a.meta.y;
    s.depth = a.meta.z;
    s.status = a.meta.w;
    s.rng = a.random.x;

    return s;
}

/**
 * @brief Pack trace state for the next dispatch without changing its RNG or affine tangent.
 */
void storeState(int i, TraceState s)
{
    states[i].p = vec4(s.p, 0);
    states[i].v = vec4(s.v, 0);
    states[i].throughput = vec4(s.throughput, 0);
    states[i].radiance = vec4(s.radiance, 0);
    states[i].integration = vec4(s.h2, s.step, s.observerLapse, s.energy);
    states[i].meta = ivec4(s.field, s.attempts, s.depth, s.status);
    states[i].random = uvec4(s.rng, uint(s.observerMode), uint(s.body + 1), 0);
}

/**
 * @brief Resume or initialize a pixel sample, advance bounded work, and update batch counters.
 * Seeds depend on pixel, completed-sample index, and user seed, not dispatch timing.
 * firstPassOnly prevents fast pixels from taking a second sample until all pixels finish
 * the first; publication of that complete pass is handled by GpuRenderer.
 */
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(pixel, dimensions)))
        return;

    int index = pixel.y * dimensions.x + pixel.x;
    vec4 sum;
    TraceState s;

    if (resetState != 0)
    {
        sum = vec4(0);
        imageStore(bodyIds, pixel, ivec4(-1));
        initTrace(s, vec3(0), vec3(0, 0, 1), seed);
        s.status = -1;
    }
    else
    {
        sum = imageLoad(accumulation, pixel);
        s = loadState(index);
    }

    for (int work = 0; work < 64; ++work)
    {
        if (int(sum.w) >= targetSamples || (firstPassOnly != 0 && sum.w >= 1.0))
            break;

        if (s.status == -1)
        {
            uint rng = hashBits(uint(index) ^ hashBits(uint(sum.w) + seed));

            if (testMode != 0)
                initTrace(s, testRays[index].origin.xyz, testRays[index].direction.xyz, seed);
            else
            {
                float u = (float(pixel.x) + randomValue(rng)) / float(dimensions.x);
                float v = (float(pixel.y) + randomValue(rng)) / float(dimensions.y);
                initTrace(s, cameraOrigin,
                          cameraCorner + u * cameraHorizontal + v * cameraVertical - cameraOrigin, rng);
            }
        }

        advanceTrace(s);

        if (s.status > 0)
        {
            if (!finiteVector(s.radiance))
                failTrace(s);

            if (s.status == 2)
                atomicAdd(failed, 1u);
            if (sum.w == 0)
            {
                int body = s.body;

                if (body < 0 && s.status == 3)
                    body = blackHole();
                if (body >= 0 && materialKind(sphereMaterial(body)) == 6)
                    body = -1;
                imageStore(bodyIds, pixel, ivec4(body));
            }

            sum += vec4(s.radiance, 1);

            if (testMode == 0)
                s.status = -1;

            // Surface lighting is much more expensive than an integration step.
            // Yield after a completed sample so a pixel cannot shade 64 Earth
            // samples in one dispatch while its neighbours are still bending.
            break;
        }
    }

    imageStore(accumulation, pixel, sum);
    storeState(index, s);

    if (int(sum.w) < targetSamples)
        atomicAdd(activePixels, 1u);
    atomicAdd(completed, uint(sum.w));

    if (sum.w < 1.0)
        atomicAdd(missingFirstSample, 1u);
}
